  "detail": {
    "ja-v-0160": {"note_extra": "行く is the single godan exception in the て-form: く normally gives いて (書いて) but 行く gives 行って."},
    "ja-v-0175": {"note_extra": "帰る, 走る, 知る, 入る and 切る all look ichidan and are godan. There are about a dozen; they are worth memorising as a set."},
    "ja-v-0234": {"note_extra": "好き is an adjective meaning 'liked', so the thing you like is the subject: コーヒーが好きです is literally 'coffee is liked'."},
    "ja-v-0173": {"note_extra": "いる for anything animate, ある for everything else. A taxi with a driver in it still takes ある."}
  }
}
